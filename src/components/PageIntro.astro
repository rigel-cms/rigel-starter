---
import { anchor, type Bind } from "./bind";
interface Props { eyebrow?: string; title: string; body?: string; bind?: Bind }
const { eyebrow = "", title, body = "", bind } = Astro.props;
---
<section class="wrap page-intro" data-rigel-section={bind ? "pageIntro" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}>
  <p class="eyebrow" data-rigel-text={anchor(bind, "eyebrow")} data-rigel-doc={bind?.doc}>{eyebrow}</p>
  <h1 data-rigel-text={anchor(bind, "title")} data-rigel-doc={bind?.doc}>{title}</h1>
  <p class="lead" data-rigel-text={anchor(bind, "body")} data-rigel-doc={bind?.doc}>{body}</p>
</section>
