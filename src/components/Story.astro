---
import Lines from "./Lines.astro";
import StoryParagraph from "./StoryParagraph.astro";
import { anchor, type Bind } from "./bind";
interface Paragraph { _key: string; title?: string; text: string }
interface Props { heading: string; paragraphs: Paragraph[]; bind?: Bind }
const { heading, paragraphs, bind } = Astro.props;
---
<section class="wrap section story" data-rigel-section={bind ? "story" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}>
  <h2 class="multiline" data-rigel-text={anchor(bind, "heading")} data-rigel-doc={bind?.doc}><Lines text={heading} /></h2>
  <div data-rigel-each={anchor(bind, "paragraphs")} data-rigel-doc={bind?.doc}>
    {paragraphs.map((paragraph) => <StoryParagraph paragraph={paragraph} bind={bind} />)}
    <template data-rigel-item-template><StoryParagraph paragraph={{ _key: "__item__", title: "", text: "" }} bind={bind} /></template>
  </div>
</section>
