---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
interface Props { post: CollectionEntry<"blog">; index?: number }
const { post, index = 0 } = Astro.props;
const blocks = Array.isArray(post.data.body.root.children) ? post.data.body.root.children : [];
const image = blocks.find(node => node.type === "image" && typeof node.src === "string" && /^(?:\/(?!\/)|https?:\/\/)/i.test(node.src));
const src = image?.src ?? ["/demo/landscape.jpg", "/demo/studio.jpg", "/demo/details.jpg"][index % 3];
const alt = typeof image?.alt === "string" ? image.alt : image ? "" : "Placeholder editorial photography";
---
<article class="article-card"><a href={`/blog/${post.data.slug || post.id}/`}><img src={src} width="1600" height="900" alt={alt} loading="lazy" /><p class="muted">{post.data.date} / {post.data.tags?.[0] ?? "Journal"}</p><h3>{post.data.title} <Icon /></h3></a></article>
