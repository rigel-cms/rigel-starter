---
import Lines from "./Lines.astro";
import WorkCard from "./WorkItem.astro";
import { anchor, type Bind } from "./bind";
interface WorkItem { _key: string; image: string; alt: string; brand: string; caption?: string }
interface Props { heading: string; items: WorkItem[]; bind?: Bind }
const { heading, items, bind } = Astro.props;
---
<section class="wrap work section" aria-labelledby="work-title" data-rigel-section={bind ? "workGrid" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}>
  <h2 id="work-title" class="multiline" data-rigel-text={anchor(bind, "heading")} data-rigel-doc={bind?.doc}><Lines text={heading} /></h2>
  <div class="work-grid" data-rigel-each={anchor(bind, "items")} data-rigel-doc={bind?.doc}>
    {items.map((item) => <WorkCard item={item} bind={bind} />)}
    <template data-rigel-item-template><WorkCard item={{ _key: "__item__", image: "", alt: "", brand: "", caption: "" }} bind={bind} /></template>
  </div>
</section>
