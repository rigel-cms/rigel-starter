---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import ArticleCard from "./ArticleCard.astro";
import { anchor, type Bind } from "./bind";
interface Props { heading: string; linkLabel?: string; linkHref?: string; posts: CollectionEntry<"blog">[]; bind?: Bind }
const { heading, linkLabel = "", linkHref = "", posts, bind } = Astro.props;
---
<section class="wrap section journal" data-rigel-section={bind ? "journal" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}>
  <div class="section-heading">
    <h2 data-rigel-text={anchor(bind, "heading")} data-rigel-doc={bind?.doc}>{heading}</h2>
    <a class="text-link" hidden={!linkLabel} data-rigel-if={anchor(bind, "linkLabel")} href={linkHref} data-rigel-href={anchor(bind, "linkHref")} data-rigel-doc={bind?.doc}><span data-rigel-text={anchor(bind, "linkLabel")} data-rigel-doc={bind?.doc}>{linkLabel}</span><Icon /></a>
  </div>
  <div class="article-grid">{posts.map((post, index) => <ArticleCard {post} {index} />)}</div>
</section>
