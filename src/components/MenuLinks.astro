---
import type { MenuItem } from "@rigel-cms/rigel/content";
interface Props { items: MenuItem[] }
const { items } = Astro.props;
---
<ul>
  {items.map((item) => (
    <li>
      <a href={item.url} target={item.newTab ? "_blank" : undefined} rel={item.newTab ? "noopener noreferrer" : undefined} aria-current={Astro.url.pathname === item.url ? "page" : undefined}>{item.label}</a>
      {item.children.length > 0 && (
        <details>
          <summary aria-label={`Expand ${item.label}`}>▾</summary>
          <Astro.self items={item.children} />
        </details>
      )}
    </li>
  ))}
</ul>
<style>
  ul { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; gap: 0.25rem; }
  li { display: flex; align-items: center; position: relative; }
  a { display: block; padding: 0.375rem 0.875rem; color: var(--muted); text-decoration: none; }
  a[aria-current="page"] { color: var(--bg); background: var(--text); }
  summary { cursor: pointer; padding: 0.375rem; list-style: none; }
  details :global(ul) { position: absolute; top: 100%; left: 0; min-width: 10rem; background: var(--bg); border: 1px solid var(--line); padding: 0.5rem; z-index: 1; }
  details :global(li) { width: 100%; }
  details :global(details ul) { position: static; }
</style>
