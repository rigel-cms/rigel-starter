---
import { anchor, type Bind } from "./bind";
interface Props { row: { _key: string; title: string; subtitle?: string; body?: string }; bind?: Bind }
const { row, bind } = Astro.props;
---
<div class="service-row" data-rigel-item={row._key}>
  <h3 data-rigel-text={anchor(bind, `rows.${row._key}.title`)} data-rigel-doc={bind?.doc}>{row.title}</h3>
  <div><p class="service-subtitle" data-rigel-text={anchor(bind, `rows.${row._key}.subtitle`)} data-rigel-doc={bind?.doc}>{row.subtitle}</p><p data-rigel-text={anchor(bind, `rows.${row._key}.body`)} data-rigel-doc={bind?.doc}>{row.body}</p></div>
</div>
