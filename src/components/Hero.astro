---
import Icon from "./Icon.astro";
import { anchor, type Bind } from "./bind";
interface Props { title: string; body: string; image: string; alt: string; label?: string; href?: string; bind?: Bind }
const { title, body, image, alt, label = "Explore services", href = "/services/", bind } = Astro.props;
---
<section class="hero wrap" data-rigel-section={bind ? "hero" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}>
  <div class="hero-copy"><p class="eyebrow">Rigel. The bright star.</p><h1 data-rigel-text={anchor(bind, "title")} data-rigel-doc={bind?.doc}>{title}</h1><p class="lead" data-rigel-text={anchor(bind, "body")} data-rigel-doc={bind?.doc}>{body}</p><a class="button" href={href} data-rigel-href={anchor(bind, "href")} data-rigel-doc={bind?.doc}><span data-rigel-text={anchor(bind, "label")} data-rigel-doc={bind?.doc}>{label}</span><Icon /></a></div>
  <img src={image} width="1000" height="1100" alt={alt} fetchpriority="high" data-rigel-image={anchor(bind, "image")} data-rigel-alt={anchor(bind, "alt")} data-rigel-doc={bind?.doc} />
</section>
