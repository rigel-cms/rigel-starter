---
import { anchor, type Bind } from "./bind";
import LogoItem from "./LogoItem.astro";
interface Logo { _key: string; image: string; alt: string }
interface Props { heading?: string; logos: Logo[]; bind?: Bind; setBind?: Bind }
const { heading = "", logos, bind, setBind } = Astro.props;
---
<section class="wrap logo-section" aria-label="Fictional demo brands" data-rigel-section={bind ? "logoStrip" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc} data-rigel-reference={anchor(bind, "logoSet")}>
  <p class="muted" data-rigel-text={anchor(bind, "heading")} data-rigel-doc={bind?.doc}>{heading}</p>
  <div class="logo-strip" data-rigel-reference-target data-rigel-each={anchor(setBind, "logos")} data-rigel-doc={setBind?.doc}>
    {logos.map((logo) => <LogoItem logo={logo} bind={setBind} />)}
    <template data-rigel-item-template><LogoItem logo={{ _key: "__item__", image: "", alt: "" }} bind={setBind} /></template>
  </div>
</section>
