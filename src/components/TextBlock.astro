---
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import { anchor, type Bind } from "./bind";
interface Props { heading: string; lead?: string; body?: string; linkLabel?: string; linkHref?: string; bind?: Bind }
const { heading, lead = "", body = "", linkLabel = "", linkHref = "", bind } = Astro.props;
---
<section class="wrap section introduction" data-rigel-section={bind ? "textBlock" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}><h2 class="multiline" data-rigel-text={anchor(bind, "heading")} data-rigel-doc={bind?.doc}><Lines text={heading} /></h2><div><p class="lead" data-rigel-text={anchor(bind, "lead")} data-rigel-doc={bind?.doc}>{lead}</p><p data-rigel-text={anchor(bind, "body")} data-rigel-doc={bind?.doc}>{body}</p><a class="text-link" hidden={!linkLabel} data-rigel-if={anchor(bind, "linkLabel")} href={linkHref} data-rigel-href={anchor(bind, "linkHref")} data-rigel-doc={bind?.doc}><span data-rigel-text={anchor(bind, "linkLabel")} data-rigel-doc={bind?.doc}>{linkLabel}</span><Icon /></a></div></section>
