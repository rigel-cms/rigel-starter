---
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import { anchor, type Bind } from "./bind";
interface Props { heading: string; email: string; emailHref: string; notice?: string; body?: string; linkLabel?: string; linkHref?: string; image: string; alt: string; bind: Bind }
const { heading, email, emailHref, notice = "", body = "", linkLabel = "", linkHref = "", image, alt, bind } = Astro.props;
---
<section class="wrap contact section" data-rigel-section="contactDetails" data-rigel-key={bind.base.split(".").pop()} data-rigel-doc={bind.doc}>
  <div>
    <h2 class="multiline" data-rigel-text={anchor(bind, "heading")} data-rigel-doc={bind.doc}><Lines text={heading} /></h2>
    <a class="email" href={emailHref} data-rigel-href={anchor(bind, "emailHref")} data-rigel-doc={bind.doc}><span data-rigel-text={anchor(bind, "email")} data-rigel-doc={bind.doc}>{email}</span> <Icon /></a>
    <p class="muted" data-rigel-text={anchor(bind, "notice")} data-rigel-doc={bind.doc}>{notice}</p>
    <p data-rigel-text={anchor(bind, "body")} data-rigel-doc={bind.doc}>{body}</p>
    <a class="text-link" href={linkHref} data-rigel-href={anchor(bind, "linkHref")} data-rigel-doc={bind.doc}><span data-rigel-text={anchor(bind, "linkLabel")} data-rigel-doc={bind.doc}>{linkLabel}</span> <Icon /></a>
  </div>
  <img src={image} width="1600" height="900" alt={alt} data-rigel-image={anchor(bind, "image")} data-rigel-alt={anchor(bind, "alt")} data-rigel-doc={bind.doc} />
</section>
