---
import { anchor, type Bind } from "./bind";
interface Props { logo: { _key: string; image: string; alt: string }; bind?: Bind }
const { logo, bind } = Astro.props;
---
<img data-rigel-item={logo._key} src={logo.image} alt={logo.alt} width="220" height="64" loading="lazy" data-rigel-image={anchor(bind, `logos.${logo._key}.image`)} data-rigel-alt={anchor(bind, `logos.${logo._key}.alt`)} data-rigel-doc={bind?.doc} />
