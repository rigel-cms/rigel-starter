---
import { anchor, type Bind } from "./bind";
interface Props { image: string; alt: string; bind?: Bind }
const { image, alt, bind } = Astro.props;
---
<div class="wrap" data-rigel-section={bind ? "wideImage" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}>
  <img class="wide-photo" src={image} width="1600" height="900" alt={alt} data-rigel-image={anchor(bind, "image")} data-rigel-alt={anchor(bind, "alt")} data-rigel-doc={bind?.doc} />
</div>
