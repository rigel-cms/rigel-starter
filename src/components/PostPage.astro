---
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import { getDocument } from "virtual:rigel-content";
import { renderArticle } from "@rigel-cms/rigel/article";
const { data, collection, body, locale = "en" } = Astro.props;
const authorNames = (Array.isArray(data.author) ? data.author : [data.author]).filter(Boolean).map((id: string) => {
  const author = getDocument(id);
  return author?.type === "author" ? String(author.data.name) : id;
}).join(", ");
---
<Base {locale} title={data.metaTitle?.trim() || data.title} description={data.description?.trim() || undefined} ogImage={data.ogImage?.trim() || undefined}>
  <article class="wrap article section">
  <p><a class="text-link" href={collection.startsWith("articles-") ? `/${locale}/studio/` : `/${collection}/`}><Icon name="arrowLeft" /> {collection.startsWith("articles-") ? (locale === "fr" ? "Le studio" : "The studio") : collection === "blog" ? "Journal" : "News"}</a></p>
  <p class="muted">
    <span data-rigel-text="date">{data.date}</span> · <span data-rigel-text="author">{authorNames}</span>
  </p>
  <h1 data-rigel-text="title">{data.title}</h1>
  <div data-rigel-richtext="$body" set:html={body ? renderArticle(body) : ""}></div>
  </article>
</Base>

<style>
  [data-rigel-richtext] :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid #a1a1aa;
    background: var(--surface);
    color: var(--muted);
  }
  [data-rigel-richtext] :global(blockquote > :first-child) { margin-top: 0; }
  [data-rigel-richtext] :global(blockquote > :last-child) { margin-bottom: 0; }
  [data-rigel-richtext] :global(pre) {
    padding: 1rem;
    overflow-x: auto;
    background: #24292e;
    color: #e1e4e8;
    font-size: 0.875rem;
    line-height: 1.6;
    tab-size: 2;
  }
  [data-rigel-richtext] :global(code) { font-family: ui-monospace, monospace; }
  [data-rigel-richtext] :global(:not(pre) > code) {
    padding: 0.125rem 0.25rem;
    background: var(--surface);
    color: var(--text);
    font-size: 0.875em;
  }
  [data-rigel-richtext] :global(img) { max-width: 100%; height: auto; }
  [data-rigel-richtext] { overflow-x: auto; }
  [data-rigel-richtext] :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
  [data-rigel-richtext] :global(:is(th, td)) { border: 1px solid var(--line); padding: 0.75rem; text-align: left; vertical-align: top; }
  [data-rigel-richtext] :global(th) { background: var(--surface); }
  [data-rigel-richtext] :global(:is(th, td) p) { margin: 0; }
</style>
