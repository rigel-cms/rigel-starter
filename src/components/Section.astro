---
import type { CollectionEntry } from "astro:content";
import { derefDocument } from "virtual:rigel-content";
import { anchor } from "./bind";
import Hero from "./Hero.astro";
import TextBlock from "./TextBlock.astro";
import LogoStrip from "./LogoStrip.astro";
import WorkGrid from "./WorkGrid.astro";
import Services from "./Services.astro";
import Journal from "./Journal.astro";
import PageIntro from "./PageIntro.astro";
import WideImage from "./WideImage.astro";
import Story from "./Story.astro";
import CTA from "./CTA.astro";
import ContactDetails from "./ContactDetails.astro";
import ArticleText from "./ArticleText.astro";
import ArticleCard from "./ArticleCard.astro";

interface Props { docId: string; section: Record<string, never>; blog: CollectionEntry<"blog">[]; news: CollectionEntry<"news">[] }
const { docId, section, blog, news } = Astro.props;
const bind = { doc: docId, base: `sections.${section._key}` };
const set = derefDocument(section.logoSet);
const callout = derefDocument(section.callout);
const setBind = { doc: set?.id ?? "", base: "" };
const calloutBind = { doc: callout?.id ?? "", base: "" };
---
{section._type === "hero"
  ? <Hero title={section.title} body={section.body} image={section.image} alt={section.alt} label={section.label} href={section.href} {bind} />
  : section._type === "textBlock"
  ? <TextBlock heading={section.heading} lead={section.lead} body={section.body} linkLabel={section.linkLabel} linkHref={section.linkHref} {bind} />
  : section._type === "logoStrip"
  ? <LogoStrip heading={String(section.heading ?? "")} logos={(set?.data.logos ?? []) as never[]} {bind} {setBind} />
  : section._type === "workGrid"
  ? <WorkGrid heading={section.heading} items={(section.items ?? []) as never[]} {bind} />
  : section._type === "services"
  ? <Services heading={section.heading} rows={(section.rows ?? []) as never[]} {bind} />
  : section._type === "journal"
  ? <Journal heading={section.heading} linkLabel={section.linkLabel} linkHref={section.linkHref} posts={blog.slice(0, 2)} {bind} />
  : section._type === "pageIntro"
  ? <PageIntro eyebrow={section.eyebrow} title={section.title} body={section.body} {bind} />
  : section._type === "wideImage"
  ? <WideImage image={section.image} alt={section.alt} {bind} />
  : section._type === "story"
  ? <Story heading={section.heading} paragraphs={(section.paragraphs ?? []) as never[]} {bind} />
  : section._type === "cta"
  ? <CTA heading={String(callout?.data.heading ?? "")} buttonLabel={String(callout?.data.buttonLabel ?? "")} href={String(callout?.data.href ?? "")} {bind} {calloutBind} />
  : section._type === "contactDetails"
  ? <ContactDetails heading={section.heading} email={section.email} emailHref={section.emailHref} notice={section.notice} body={section.body} linkLabel={section.linkLabel} linkHref={section.linkHref} image={section.image} alt={section.alt} {bind} />
  : section._type === "articleText"
  ? <ArticleText title={section.title} intro={section.intro} subheading={section.subheading} body={section.body} linkLabel={section.linkLabel} linkHref={section.linkHref} closing={section.closing} {bind} />
  : section._type === "blogFeed"
  ? <section class="wrap section" aria-label="Journal articles" data-rigel-section="blogFeed" data-rigel-key={section._key} data-rigel-doc={docId}><h2 data-rigel-text={anchor(bind, "heading")} data-rigel-doc={docId}>{section.heading}</h2><div class="article-grid">{blog.map((post, index) => <ArticleCard post={post} index={index} />)}</div></section>
  : section._type === "newsFeed"
  ? <section class="wrap section" aria-label="News articles" data-rigel-section="newsFeed" data-rigel-key={section._key} data-rigel-doc={docId}><h2 data-rigel-text={anchor(bind, "heading")} data-rigel-doc={docId}>{section.heading}</h2><ul>{news.map(post => <li><a href={`/news/${post.data.slug || post.id}/`}>{post.data.title}</a></li>)}</ul></section>
  : null}
