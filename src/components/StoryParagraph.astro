---
import { anchor, type Bind } from "./bind";
interface Props { paragraph: { _key: string; title?: string; text: string }; bind?: Bind }
const { paragraph, bind } = Astro.props;
---
<div class="story-paragraph" data-rigel-item={paragraph._key}>
  <h3 hidden={!paragraph.title} data-rigel-if={anchor(bind, `paragraphs.${paragraph._key}.title`)} data-rigel-text={anchor(bind, `paragraphs.${paragraph._key}.title`)} data-rigel-doc={bind?.doc}>{paragraph.title}</h3>
  <p data-rigel-text={anchor(bind, `paragraphs.${paragraph._key}.text`)} data-rigel-doc={bind?.doc}>{paragraph.text}</p>
</div>
<style>
  .story-paragraph + .story-paragraph { margin-top: 1.25rem; }
  .story-paragraph + .story-paragraph:has(> h3:not([hidden])) { margin-top: 28px; }
  .story-paragraph h3 { margin-top: 0; }
  .story-paragraph h3[hidden] + p { margin-top: 0; }
</style>
