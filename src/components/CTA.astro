---
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import { anchor, type Bind } from "./bind";
interface Props { heading?: string; buttonLabel?: string; href?: string; bind?: Bind; calloutBind?: Bind }
const { heading = "Make room for\nyour next idea.", buttonLabel = "Get in touch", href = "/contact/", bind, calloutBind } = Astro.props;
---
<section class="wrap section" data-rigel-reference={anchor(bind, "callout")} data-rigel-section={bind ? "cta" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}>
  <div class="cta">
    <h2 class="multiline" data-rigel-text={anchor(calloutBind, "heading")} data-rigel-doc={calloutBind?.doc}><Lines text={heading} /></h2>
    <a class="button" href={href} data-rigel-href={anchor(calloutBind, "href")} data-rigel-doc={calloutBind?.doc}><span data-rigel-text={anchor(calloutBind, "buttonLabel")} data-rigel-doc={calloutBind?.doc}>{buttonLabel}</span><Icon /></a>
  </div>
</section>
