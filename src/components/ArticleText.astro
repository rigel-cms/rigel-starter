---
import { anchor, type Bind } from "./bind";
interface Props { title: string; intro?: string; subheading?: string; body?: string; linkLabel?: string; linkHref?: string; closing?: string; bind: Bind }
const { title, intro = "", subheading = "", body = "", linkLabel = "", linkHref = "", closing = "", bind } = Astro.props;
---
<section class="wrap article section" data-rigel-section="articleText" data-rigel-key={bind.base.split(".").pop()} data-rigel-doc={bind.doc}>
  <h1 data-rigel-text={anchor(bind, "title")} data-rigel-doc={bind.doc}>{title}</h1>
  <p data-rigel-text={anchor(bind, "intro")} data-rigel-doc={bind.doc}>{intro}</p>
  <h2 data-rigel-text={anchor(bind, "subheading")} data-rigel-doc={bind.doc}>{subheading}</h2>
  <p data-rigel-text={anchor(bind, "body")} data-rigel-doc={bind.doc}>{body}</p>
  <p><a href={linkHref} data-rigel-href={anchor(bind, "linkHref")} data-rigel-text={anchor(bind, "linkLabel")} data-rigel-doc={bind.doc}>{linkLabel}</a></p>
  <p data-rigel-text={anchor(bind, "closing")} data-rigel-doc={bind.doc}>{closing}</p>
</section>
