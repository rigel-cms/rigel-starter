---
import Lines from "./Lines.astro";
import ServiceRow from "./ServiceRow.astro";
import { anchor, type Bind } from "./bind";
interface Row { _key: string; title: string; subtitle?: string; body?: string }
interface Props { heading?: string; rows?: Row[]; bind?: Bind }
const { heading = "From the first thought\nto the final detail.", rows = [
  { _key: "kservicestrategy", title: "Brand strategy", subtitle: "A clear starting point.", body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean eu leo quam. Pellentesque ornare sem lacinia quam venenatis vestibulum." },
  { _key: "kserviceidentity", title: "Visual identity", subtitle: "A character of your own.", body: "Integer posuere erat a ante venenatis dapibus posuere velit aliquet. Curabitur blandit tempus porttitor. Donec sed odio dui." },
  { _key: "kservicedigital", title: "Digital experiences", subtitle: "Built to be useful.", body: "Maecenas faucibus mollis interdum. Nulla vitae elit libero, a pharetra augue. Cras mattis consectetur purus sit amet fermentum." },
], bind } = Astro.props;
---
<section class="wrap section services" data-rigel-section={bind ? "services" : undefined} data-rigel-key={bind?.base.split(".").pop()} data-rigel-doc={bind?.doc}><h2 class="multiline" data-rigel-text={anchor(bind, "heading")} data-rigel-doc={bind?.doc}><Lines text={heading} /></h2><div class="service-rows" data-rigel-each={anchor(bind, "rows")} data-rigel-doc={bind?.doc}>
  {rows.map((row) => <ServiceRow row={row} bind={bind} />)}
  <template data-rigel-item-template><ServiceRow row={{ _key: "__item__", title: "", subtitle: "", body: "" }} bind={bind} /></template>
</div></section>
