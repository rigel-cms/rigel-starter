---
import { anchor, type Bind } from "./bind";
interface Props { item: { _key: string; image: string; alt: string; brand: string; caption?: string }; bind?: Bind }
const { item, bind } = Astro.props;
---
<figure data-rigel-item={item._key}>
  <img src={item.image} width="1600" height="900" alt={item.alt} loading="lazy" data-rigel-image={anchor(bind, `items.${item._key}.image`)} data-rigel-alt={anchor(bind, `items.${item._key}.alt`)} data-rigel-doc={bind?.doc} />
  <figcaption><strong data-rigel-text={anchor(bind, `items.${item._key}.brand`)} data-rigel-doc={bind?.doc}>{item.brand}</strong><span data-rigel-text={anchor(bind, `items.${item._key}.caption`)} data-rigel-doc={bind?.doc}>{item.caption}</span></figcaption>
</figure>
