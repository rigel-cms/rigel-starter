---
import Base from "../layouts/Base.astro";
import SectionRenderer from "./SectionRenderer.astro";
import schema from "../content/schema";
interface Props { doc: { id: string; type: string; data: Record<string, unknown> } }
const { doc } = Astro.props;
const definition = schema.documents.find(type => type.name === doc.type);
---
<Base locale={definition?.locale ?? "en"} title={String(doc.data.metaTitle ?? "").trim() || String(doc.data.title)} description={String(doc.data.description ?? "").trim() || undefined} ogImage={String(doc.data.ogImage ?? "").trim() || undefined}>
  <SectionRenderer {doc} />
</Base>
