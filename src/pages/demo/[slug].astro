---
import Base from "../../layouts/Base.astro";
import { getDocument } from "virtual:rigel-content";

export function getStaticPaths() {
  const doc = getDocument("demo:fields");
  return doc ? [{ params: { slug: "fields" }, props: { doc } }] : [];
}

const { doc } = Astro.props;
const hours = doc.data.openingHours as { _key: string; day: string; hours: string }[];
---
<Base title="Demo fields">
  <section class="wrap section">
    <h1>{String(doc.data.siteName)}</h1>
    <p>Brand color: <span class="swatch" style:background-color={String(doc.data.brandColor)} aria-label={`Brand color ${doc.data.brandColor}`}></span> <span>{String(doc.data.brandColor)}</span></p>
    <h2>Opening hours</h2>
    <ul>{hours.map(item => <li>{item.day}: {item.hours}</li>)}</ul>
  </section>
</Base>

<style>
  .swatch { display: inline-block; width: 2rem; height: 2rem; vertical-align: middle; border: 1px solid var(--line); }
</style>
