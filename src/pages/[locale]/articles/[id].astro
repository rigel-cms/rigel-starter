---
import { multilingual } from "../../../multilang.mjs";
import { getCollection } from "astro:content";
import PostPage from "../../../components/PostPage.astro";

export async function getStaticPaths() {
  if (!multilingual) return [];
  const entries = await Promise.all((["articles-en", "articles-fr"] as const).map(async collection =>
    (await getCollection(collection)).filter(post => import.meta.env.DEV || !post.data.draft)
      .map(post => ({ params: { locale: collection === "articles-fr" ? "fr" : "en", id: post.data.slug || post.id }, props: { post, collection } }))));
  return entries.flat();
}
const { post, collection } = Astro.props;
---
<PostPage data={post.data} body={post.data.body} {collection} locale={Astro.params.locale} />
