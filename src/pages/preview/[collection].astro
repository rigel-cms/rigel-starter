---
import { multilingual } from "../../multilang.mjs";
import PostPage from "../../components/PostPage.astro";
export function getStaticPaths() {
  return ["blog", "news", ...(multilingual ? ["articles-en", "articles-fr"] : [])].map(collection => ({ params: { collection } }));
}
const { collection } = Astro.params;
const locale = collection?.endsWith("-fr") ? "fr" : "en";
---
<PostPage data={{ title: "New post", date: "", author: "" }} collection={collection} {locale} />
