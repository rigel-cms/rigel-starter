            {
              "detail": 0,
              "format": 0,
              "mode": "normal",
              "style": "",
              "text": " tells readers where they are going before they leave the page.",
              "type": "text",
              "version": 1
            }
          ],
          "direction": null,
          "format": "",
          "indent": 0,
          "type": "paragraph",
          "version": 1,
