---
import logo from "../assets/rigelcms-icon.png?url";
import footerMenu from "../content/menus/footer.json";
import { getDocument } from "virtual:rigel-content";
import MenuLinks from "../components/MenuLinks.astro";
import Icon from "../components/Icon.astro";
import "../styles/site.css";
const links = [["/about/", "Studio"], ["/services/", "Services"], ["/blog/", "Journal"], ["/news/", "News"], ["/rigel/", "CMS Studio"], ["/contact/", "Get in touch"]];
const settings = getDocument("settings:site")!;
const { title = String(settings.data.siteName), description = String(settings.data.metaDescription), ogImage, locale = "en" } = Astro.props;
const imageUrl = typeof ogImage === "string" && ogImage.trim() ? new URL(ogImage.trim(), Astro.site ?? Astro.url) : undefined;
const socialImage = imageUrl && ["https:", "http:"].includes(imageUrl.protocol) ? imageUrl.href : undefined;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {socialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={socialImage} />
    </>}
    <meta name="color-scheme" content="light" />
    <title>{title} | {String(settings.data.siteName)}</title>
    <link rel="icon" href={logo} type="image/png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" class="brand" aria-label={`${settings.data.siteName} home`}><img src={logo} width="40" height="40" alt="" />{String(settings.data.siteName)}</a>
      <nav class="desktop-nav" aria-label="Primary">{links.map(([url, label]) => <a class:list={[{ button: url === "/contact/" }]} href={url} aria-current={Astro.url.pathname === url ? "page" : undefined}>{label}{url === "/contact/" && <Icon />}</a>)}</nav>
      <details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile">{links.map(([url, label]) => <a href={url} aria-current={Astro.url.pathname === url ? "page" : undefined}>{label}</a>)}</nav></details>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-bottom"><p class="copyright">{String(settings.data.copyright)}</p><nav aria-label="Footer"><MenuLinks items={footerMenu.items} /></nav></div>
    </footer>
  </body>
</html>
